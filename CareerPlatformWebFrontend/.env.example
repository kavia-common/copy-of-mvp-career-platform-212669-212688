# Frontend environment variables (example)
# Copy this file to ".env" and customize values for your environment.

# Full backend origin (protocol + host + port). Example: http://localhost:3001
REACT_APP_BACKEND_URL=http://localhost:3001

# API base path exposed by the backend (default: /api/v1)
REACT_APP_API_BASE=/api/v1

# Frontend origin (optional; used for redirects and docs)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional: WebSocket base URL for real-time features (not used in MVP flows yet)
REACT_APP_WS_URL=ws://localhost:3001

# Misc flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=true
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature flags (comma-separated)
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
