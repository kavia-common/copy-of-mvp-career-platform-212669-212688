# Frontend environment configuration (copy to .env and adjust values)

# Option A (recommended): Full API base URL including version path
# Example for dev environment where backend is on port 3001
REACT_APP_API_BASE_URL=https://vscode-internal-12567-beta.beta01.cloud.kavia.ai:3001/api/v1

# Option B: Compose from backend origin and API base path
# REACT_APP_BACKEND_URL=https://vscode-internal-12567-beta.beta01.cloud.kavia.ai:3001
# REACT_APP_API_BASE=/api/v1

# Optional: Explicit frontend origin (used for redirects; defaults to window.location.origin)
# REACT_APP_FRONTEND_URL=https://vscode-internal-12567-beta.beta01.cloud.kavia.ai:3000
